# Deny everything, then explicitly allow only what the build needs. Keeping the build context
# minimal speeds up the build, stops unrelated edits invalidating cached layers, and keeps local
# secrets and scratch files out of the context.
*

!Directory.Build.props
!Directory.Packages.props
!global.json
!src/**/*.csproj
!src/**/*.cs
!src/**/*.cshtml
!src/**/appsettings*.json
!src/webapp/wwwroot/**

# Re-excluded beneath the allow-list above, so build output never reaches the context. The
# trailing /** matters: a bare **/obj would still send the matched files as empty stubs.
**/bin/**
**/obj/**
